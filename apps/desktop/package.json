{
  "name": "@slackoss/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "description": "Gatherline — self-hosted team chat",
  "author": "Gatherline contributors",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "pnpm --filter @slackoss/web build && electron-vite build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@slackoss/client-core": "workspace:*",
    "@slackoss/protocol": "workspace:*",
    "@slackoss/server": "workspace:*",
    "@slackoss/ui": "workspace:*",
    "bonjour-service": "^1.3.0",
    "fastify": "^5.12.5",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
