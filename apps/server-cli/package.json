{
  "name": "slackoss-server",
  "version": "0.1.0",
  "description": "Self-hosted Gatherline workspace server — run it on a VPS or your own PC",
  "license": "MIT",
  "type": "module",
  "bin": {
    "slackoss-server": "./dist/slackoss-server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/slackoss-server.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@slackoss/server": "workspace:*",
    "@slackoss/web": "workspace:*",
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
